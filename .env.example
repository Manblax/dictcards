# Copy this file to .env for Docker Compose development.
# Replace the public URLs with HTTPS domains in production.

FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_CALLBACK_URL=http://localhost:3001/auth/yandex/callback

# Docker-network URLs normally stay internal in both environments.
INTERNAL_API_URL=http://backend:3001
DICTIONARY_SERVICE_URL=http://dictionary-service:4000

# Google Cloud TTS (separate from Google OAuth login).
TTS_VOICE_UK=en-GB-Chirp3-HD-Achernar
TTS_VOICE_US=en-US-Chirp3-HD-Achernar
# Absolute host path; used only with docker-compose.tts.yml.
TTS_CREDENTIALS_FILE=/absolute/path/outside/repo/google-tts-credentials.json
