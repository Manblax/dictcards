map $http_upgrade $connection_upgrade {
  default upgrade;
  "" close;
}

server {
  listen 80;
  listen [::]:80;
  server_name ${PUBLIC_IP};

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  location / {
    return 301 https://${PUBLIC_IP}$request_uri;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${PUBLIC_IP};

  ssl_certificate /etc/letsencrypt/live/dictcards-ip/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/dictcards-ip/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  client_max_body_size 10m;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-Port $server_port;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;

  # User uploads share the application origin; never allow active documents
  # to execute scripts with access to the application's session.
  location ^~ /uploads/ {
    add_header Content-Security-Policy "sandbox" always;
    add_header X-Content-Type-Options nosniff always;
    proxy_pass http://backend:3001;
  }

  # Preserve /auth/callback for Next.js; only API auth routes go to NestJS.
  location ~ ^/(auth/(login|register|google|yandex)(/|$)|dictcards(/|$)|dictionary(/|$)|uploads?(/|$)|tts(/|$)) {
    proxy_pass http://backend:3001;
    proxy_read_timeout 60s;
  }

  location / {
    proxy_pass http://frontend:3000;
  }
}
