# Public DNS names. Do not include schemes or paths.
FRONTEND_HOST=app.example.com
API_HOST=api.example.com

# This must match the NEXT_PUBLIC_API_URL GitHub Actions repository variable
# used when the frontend image was built.
NEXT_PUBLIC_API_URL=https://api.example.com

# Use an immutable tag published by CD, for example sha-7fd775d.
IMAGE_TAG=sha-0000000

# TLS and reverse-proxy settings.
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_SERVER=https://acme-v02.api.letsencrypt.org/directory
CLIENT_MAX_BODY_SIZE=10m

# Database and authentication secrets. Replace every example value.
POSTGRES_USER=dictcards
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=dictcards
DATABASE_URL=postgresql://dictcards:replace-with-a-long-random-password@postgres:5432/dictcards
JWT_SECRET=replace-with-a-long-random-jwt-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
YANDEX_CLIENT_ID=replace-with-yandex-client-id
YANDEX_CLIENT_SECRET=replace-with-yandex-client-secret
# Compose derives YANDEX_CALLBACK_URL as https://${API_HOST}/auth/yandex/callback.

# Internal Docker service URLs and settings.
INTERNAL_API_URL=http://backend:3001
DICTIONARY_SERVICE_URL=http://dictionary-service:4000
DICTIONARY_CACHE_TTL_DAYS=30
DICTIONARY_BACKEND_TIMEOUT_MS=9000
DICTIONARY_TIMEOUT_MS=6000

# Google Cloud TTS (separate from Google OAuth login).
TTS_VOICE_UK=en-GB-Chirp3-HD-Achernar
TTS_VOICE_US=en-US-Chirp3-HD-Achernar
# Absolute host path; used only with docker-compose.tts.yml.
TTS_CREDENTIALS_FILE=/absolute/path/outside/repo/google-tts-credentials.json
