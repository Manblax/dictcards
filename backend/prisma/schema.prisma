// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL") // Пока отключим для локальной разработки
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  yandexId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules   Module[]
}

model Module {
  id          String   @id @default(uuid())
  title       String
  description String?
  author      String
  termCount   Int      @default(0)
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  terms       Term[]

  @@index([userId])
}

model Term {
  id          String   @id @default(uuid())
  term        String
  definition  String
  image       String?
  isFavorite  Boolean  @default(false)
  position    Int      @default(0)
  
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([moduleId, position])
}

model DictionaryEntry {
  id               String    @id @default(uuid())
  normalizedWord   String
  dictionarySource String    @default("cambridge")
  payload          Json
  sourceMap        Json?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([normalizedWord, dictionarySource])
}

model DictionaryAudio {
  id        String   @id
  variant   String
  source    String
  sourceUrl String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TtsAudio {
  hash      String   @id
  audio     Bytes
  createdAt DateTime @default(now())
}
