#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
scanner="$(git rev-parse --git-path tools/gitleaks)"
if command -v gitleaks >/dev/null 2>&1; then
  scanner="$(command -v gitleaks)"
elif [[ ! -x "$scanner" ]]; then
  echo "Gitleaks is required before committing. See docs/security.md." >&2
  exit 1
fi

exec "$scanner" git . --pre-commit --staged --redact=100 --no-banner
